# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/findora

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (frontend uses this too, kept here for reference)
GOOGLE_MAPS_API_KEY=

# AI Matching service
# When empty, the app falls back to the deterministic mock matching engine
# in services/aiMatchingService.js. Point this at a real model endpoint later.
AI_MATCHING_API_URL=
AI_MATCHING_API_KEY=
